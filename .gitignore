# macOS
.DS_Store

# Xcode user state and build products
DerivedData/
build/
*.xcuserstate
*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# Go build and test artifacts
bin/
*.test
coverage.out

# Local scratch files and generated test reports
/tmp/
/temp/
/.tmp/
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.xcresult/

# Local environment and secrets
.env
.env.*
!.env.example

# Editor files
.idea/
.vscode/
*.swp

# Local web research cache
.firecrawl/

# Private inputs and recordings must remain outside this public repository.
/assets/
/frontend/assets/

# Obsidian: share only portable knowledge-base settings.
/docs/.obsidian/*
!/docs/.obsidian/app.json
!/docs/.obsidian/core-plugins.json
!/docs/.obsidian/templates.json
/docs/.trash/

# Knowledge base excludes execution artifacts; keep outputs outside docs.
/docs/validation/
/docs/reports/
/docs/test-results/
/docs/playwright-report/
